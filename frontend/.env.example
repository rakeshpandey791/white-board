# Keep empty for same-origin deployment (frontend bundled with backend).
# For split deployment (frontend domain != backend domain), set:
# Example:
# VITE_API_BASE_URL=https://whiteboard-backend.onrender.com/api
# VITE_WS_ENDPOINT=https://whiteboard-backend.onrender.com/ws

VITE_API_BASE_URL=
VITE_WS_ENDPOINT=
