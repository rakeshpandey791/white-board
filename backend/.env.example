# Backend environment template (Render / local production-like)
# Do NOT commit real secrets.

# ---- Database (Neon PostgreSQL example) ----
DB_URL=jdbc:postgresql://ep-xxxx.ap-southeast-1.aws.neon.tech/whiteboard?sslmode=require
DB_USER=whiteboard_owner
DB_PASSWORD=replace_me

# ---- Redis (set REDIS_ENABLED=false initially to simplify first deploy) ----
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false

# ---- Security ----
APP_JWT_SECRET=replace_with_long_random_secret
JWT_EXP_MINUTES=120

# ---- CORS ----
# Single-domain deployment: *
# Split frontend/backend deployment: comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=*

# ---- Server ----
# Render sets PORT automatically
PORT=8080

# ---- Seed users ----
SEED_USERS=false
SEED_USERS_COUNT=100
